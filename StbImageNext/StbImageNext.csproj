<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net471;net8.0</TargetFrameworks>
    <Description>C# Image Library based on StbImageNext, StbImageWriteSharp, StbImageResizeSharp and StbDxtSharp</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>StbImageNext</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsAotCompatible>true</IsAotCompatible>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
</Project>